# Reportly web — copy to `.env` (gitignored). Vite exposes only VITE_-prefixed
# vars to the client. The dev server proxies /api to the API (see vite.config.ts),
# so no API URL is needed in development.
# On Windows, Hyper-V and Docker Desktop reserve blocks of TCP ports, and the
# blocks move after a reboot. If a block swallows this one the dev server still
# starts and serves fine inside WSL, but localhost:<port> refuses from the browser
# — which looks like a broken app rather than a taken port. Check with
#   netsh interface ipv4 show excludedportrange protocol=tcp
# and pick a port outside every listed range.
WEB_PORT=5173
API_PORT=3000

# Where the "Documentation" links in the account menu and on the sign-in screens
# point. Leave unset to use the public site. Set it to your own copy when the
# installation cannot reach the internet — a closed network sending people to
# github.io is sending them nowhere.
#
# Vite substitutes this at BUILD time, so changing it means rebuilding the web
# image rather than restarting it.
VITE_DOCS_URL=
