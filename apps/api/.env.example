# Reportly API — copy to `.env` (gitignored). Values below are dev defaults.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Directory for the rotating file log sink.
LOG_DIR=logs

# Comma-separated allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# --- Attachment storage ---
# Where NEW attachments are written: `local` or `s3`. Existing files keep the
# backend they were uploaded to; run `cli storage:migrate` to move them.
STORAGE_BACKEND=local
# Local backend directory. In containers this MUST be a mounted volume — the
# image runs on a read-only root filesystem.
STORAGE_LOCAL_DIR=uploads
# Hard ceiling on one upload, enforced as it streams (protects the heap). The
# per-organisation limit is the smaller `storage.uploads` setting in the app.
STORAGE_MAX_UPLOAD_MB=50
# S3-compatible backend (AWS, MinIO, R2, Backblaze). Only read when STORAGE_BACKEND=s3.
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=reportly
# Omit both keys to use ambient credentials (an instance role).
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# MinIO needs path-style addressing; AWS does not.
# S3_FORCE_PATH_STYLE=false

# App database and separate log database (same instance by default).
DATABASE_URL=postgres://reportly:reportly@localhost:5432/reportly
LOG_DATABASE_URL=postgres://reportly:reportly@localhost:5432/reportly_logs

# How backups shell out to the Postgres client tools. Just the binary by default;
# override when the API host has none — e.g. `docker exec reportly-postgres-1 pg_dump`
# in a compose setup. Split on spaces.
# PG_DUMP_CMD=pg_dump
# PG_RESTORE_CMD=pg_restore

# Redis (cache, rate limits, queues).
REDIS_URL=redis://localhost:6379

# Queue management screen. Off by default: its routes are not mounted at all, so
# an upgrade never silently exposes a page that can pause the queue carrying
# every password reset. `read` to look, `manage` to retry/remove/pause/clean.
# QUEUE_ADMIN=off

# Auth (better-auth). MUST be overridden in real environments with a long random value.
BETTER_AUTH_SECRET=dev-only-insecure-secret-change-me
BETTER_AUTH_URL=http://localhost:3000

# Outbound email (dev uses Mailpit; UI at http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM=Reportly <no-reply@reportly.local>
WEB_URL=http://localhost:5173

# Seeded superadmin (password is set separately via `pnpm --filter api cli reset-superadmin`).
SUPERADMIN_EMAIL=admin@reportly.local
SUPERADMIN_NAME=Super Admin

# --- things that are off by default, listed so you know they exist ---

# Allow public self-service sign-up. Off by default: accounts are created by an
# administrator or by invitation.
# ALLOW_REGISTRATION=false

# How to derive the client IP behind a reverse proxy. Empty trusts no proxy, which
# is right only when clients reach the API directly. Behind the bundled nginx set
# `1` (trust one hop), or list trusted proxy IPs/CIDRs. Without it, per-IP rate
# limits and audit IPs all record the proxy rather than the caller. Never `true` on
# a public listener — any client could then spoof its own IP.
# TRUST_PROXY=1

# Permit `production` to run over plain HTTP. Session cookies then lose the
# `Secure` flag and travel in clear text. Only ever for a trusted private network.
# ALLOW_INSECURE_HTTP=false

# Path to a MaxMind GeoLite2 .mmdb, to put a location on security events. Unset
# records no location.
# GEOIP_DB=/var/lib/reportly/GeoLite2-City.mmdb
