# Reportly — root environment template.
# Copy to `.env` (gitignored) for docker-compose. App-specific vars live in each
# app's own .env.example (apps/api/.env.example, apps/web/.env.example).

# --- Postgres (dev compose provisions both databases on one instance) ---
POSTGRES_USER=reportly
POSTGRES_PASSWORD=reportly
POSTGRES_DB=reportly
POSTGRES_LOG_DB=reportly_logs
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Mailpit (dev SMTP capture) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- App ports (dev) ---
API_PORT=3000
WEB_PORT=5173
