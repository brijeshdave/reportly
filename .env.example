# Reportly — root environment template.
# Copy to `.env` (gitignored) for docker-compose. App-specific vars live in each
# app's own .env.example (apps/api/.env.example, apps/web/.env.example).

PROJECT_NAME=reportly

# --- Postgres (dev compose provisions both databases on one instance) ---
POSTGRES_USER=reportly
POSTGRES_PASSWORD=reportly
POSTGRES_DB=reportly
POSTGRES_LOG_DB=reportly_logs
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Mailpit (dev SMTP capture) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- App ports (dev) ---
API_PORT=3000
WEB_PORT=5173

# ---------------------------------------------------------------------------
# Application settings
#
# `compose.prod.yaml` hands this whole file to the API and migrate services
# (`env_file:`), so anything the app understands can be set here. Only values
# compose itself computes — the database URLs, container paths, NODE_ENV — are
# fixed in the compose file and cannot be overridden from here.
# ---------------------------------------------------------------------------

# --- Required in production ---
# Session cookies are signed with this. Without it the API falls back to its
# development secret and every cookie in the deployment is forgeable.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Externally reachable URLs. Emailed links point at WEB_URL. Both must be https
# unless ALLOW_INSECURE_HTTP is set, or the session cookie loses its Secure flag.
BETTER_AUTH_URL=https://reportly.example.com
WEB_URL=https://reportly.example.com
CORS_ORIGIN=https://reportly.example.com
# Only for a trusted private network with no TLS terminator.
ALLOW_INSECURE_HTTP=false

# How the client IP is derived behind a reverse proxy. **Set this.** Left empty,
# every caller looks like the proxy: the per-account sign-in throttle collapses
# onto one shared bucket and every audit row records the proxy's address.
# `1` behind the bundled nginx; `2` when Caddy/TLS is in front as well.
TRUST_PROXY=1

# --- Outbound mail ---
# Without a reachable relay, invitations and password resets are queued and never
# delivered. `cli doctor` connects and authenticates, so a bad relay is caught at
# deploy time rather than by somebody who never got their email.
#
# Port 587 is STARTTLS and needs SMTP_SECURE=false; port 465 is implicit TLS and
# needs SMTP_SECURE=true. Mismatching them is the most common cause of failure.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=
# Must be a sender your provider has verified; the default reportly.local is not.
MAIL_FROM=Reportly <no-reply@reportly.example.com>

# Public self-service sign-up. Off by default: accounts are created by an
# administrator or by invitation, and the superadmin and invite flows are
# unaffected either way.
ALLOW_REGISTRATION=false

# --- The first administrator, created by `cli seed` ---
SUPERADMIN_EMAIL=admin@reportly.local
SUPERADMIN_NAME=Super Admin

# --- Optional ---
# Queue screen: off | read | manage. Off means the routes are not mounted at all,
# so the menu is absent even for a superadmin.
QUEUE_ADMIN=off
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Country and city on audit rows, when a MaxMind database is mounted.
# GEOIP_DB=/data/geoip/GeoLite2-City.mmdb

# Attachments: local (the mounted volume) or s3.
STORAGE_BACKEND=local
STORAGE_MAX_UPLOAD_MB=50
# S3_ENDPOINT=            # MinIO/R2/Backblaze; omit for AWS itself
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=       # omit both keys to use ambient instance credentials
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# Backup tooling. The image ships its own client; override only to reach a server
# whose major version is newer than the bundled pg_dump.
# PG_DUMP_CMD=pg_dump
# PG_RESTORE_CMD=pg_restore

# Development machines only, and refused outright when NODE_ENV=production.
# ALLOW_DEV_RESTORE=false
# ALLOW_DEV_SEED=false
