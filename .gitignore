# Private working notes — never committed
.private

# Bind-mount data, when a service is switched off named volumes. Created by
# `scripts/data-dirs.sh` and holding databases, uploads and backups — none of
# which belongs in a public repository.
/data/

# Dependencies
node_modules

# Build output
dist
build
.turbo

# Env (keep *.example)
.env
.env.*
!.env.example
!**/.env.example
# `.env.*` above swallows this one too — it is a template, not a real env file.
!.env.production.example

# Kubernetes real secrets (keep *.example.yaml)
deploy/k8s/secret.yaml

# Your own compose file. `compose.dev.yaml` (development) and `compose.prod.yaml`
# (the shipped production reference) are tracked, so a pull rewrites them. The four
# names below are the ones Docker Compose picks up on its own: whichever you write
# is yours to tailor, and staying untracked is what stops a pull overwriting it.
# `scripts/upgrade.sh` finds it the same way, so it drives the stack you run.
compose.yaml
compose.yml
docker-compose.yaml
docker-compose.yml
compose.override.yaml
compose.override.yml

# Test / coverage
coverage

# Logs
*.log
# Log output directories only — anchored so they never match source dirs
# such as apps/api/src/features/logs.
/logs
apps/api/logs
apps/api/.tmp-logs

# Attachments written by the local storage backend. Anchored for the same reason:
# there is a src/features/attachments that must stay tracked.
/uploads
apps/api/uploads

# OS / editor
.DS_Store

# VitePress build output and cache
docs/.vitepress/dist
docs/.vitepress/cache
