# Reportly — production environment template.
#
# Copy to `.env` next to docker-compose.prod.yml and fill in the marked values:
#
#   cp .env.production.example .env
#   ${EDITOR:-nano} .env
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Or let scripts/install-ubuntu.sh generate the secrets and write this for you.
#
# Anything not listed here has a safe default; see docs/reference/environment.md
# for the full list. The API refuses to boot on an insecure production config
# rather than quietly weakening itself, so a mistake here is a failed start, not
# a silent hole.

# ---------------------------------------------------------------- REQUIRED ---

# Database. The password is used to build DATABASE_URL, so change it BEFORE the
# first start — after that it is baked into the Postgres volume and changing it
# here alone locks the app out of its own database.
POSTGRES_USER=reportly
POSTGRES_PASSWORD=CHANGE-ME-strong-database-password

# Signs every session cookie. If this were left at the development default,
# anyone could forge a session for any account. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE-ME-openssl-rand-base64-32

# Outbound mail. Invitations and password resets are queued and never delivered
# without a reachable relay, which means nobody can be onboarded.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Reportly <no-reply@example.com>

# ---------------------------------------------------------------- ADDRESSES ---
# Where people reach Reportly. Emailed links point at WEB_URL, so a wrong value
# here sends everyone to a dead address.
#
# On a real hostname these MUST be https, or the API refuses to start: the
# session cookie would otherwise lose its Secure flag and travel in clear text.
WEB_URL=https://reportly.example.com
BETTER_AUTH_URL=https://reportly.example.com
CORS_ORIGIN=https://reportly.example.com

# Running on a trusted private network with no TLS? Set this to true and use
# http:// above. Understand what you are turning off before you do.
ALLOW_INSECURE_HTTP=false

# ---------------------------------------------------------------------- TLS ---
# Only read with `--profile tls`. Point this name's DNS at this machine first;
# Caddy then obtains and renews the certificate on its own.
PUBLIC_HOSTNAME=reportly.example.com
ACME_EMAIL=ops@example.com

# With the tls profile there are two proxy hops (Caddy, then the web container's
# nginx), so the API must skip two to find the real client IP. Without the
# profile it is 1. Get this wrong and per-IP rate limits and audit records show
# a proxy address instead of the caller.
TRUST_PROXY=2

# Keep the web container off the public interface when Caddy is in front of it —
# Caddy reaches it over the internal network, and nothing else needs to.
WEB_PUBLIC_PORT=127.0.0.1:8080

# ------------------------------------------------------------------ OPTIONAL ---

# First superadmin. The password is NOT set here; it is printed once by
#   docker compose -f docker-compose.prod.yml run --rm api node dist/cli/index.js reset-superadmin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_NAME=Super Admin

# Attachment storage. `local` writes to the app-data volume (backed up by the
# in-app files backup). Switch to `s3` for object storage and set the S3_* vars
# from docs/reference/environment.md.
STORAGE_BACKEND=local
STORAGE_MAX_UPLOAD_MB=50

# Database names. Logs live in their own database so their volume never affects
# the app. Changing these after the first start requires creating the databases
# by hand.
POSTGRES_DB=reportly
POSTGRES_LOG_DB=reportly_logs
